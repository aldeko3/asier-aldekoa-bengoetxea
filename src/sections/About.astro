---
import SectionTitle from "../components/SectionTitle.astro";
---

<section
  id="about"
  class="flex min-h-screen w-full items-center bg-primary px-6 py-24 text-secondary supports-[height:100dvh]:min-h-dvh"
>
  <div
    class="mx-auto flex max-w-6xl flex-col gap-12"
  >
    <SectionTitle title="Soy Asier" color="text-secondary" number="01" numberBackground="bg-primary" />

    <p class="max-w-3xl font-secondary-heavy text-xl uppercase text-center md:text-3xl">
      Ingeniero Informático especializado en el ecosistema Microsoft 365 y
      SharePoint Online, centrado en el desarrollo de soluciones empresariales
      con SharePoint Framework (SPFx), React y TypeScript. Experto en la
      creación de componentes personalizados, administración técnica,
      gobernanza y arquitectura de la información en portales corporativos.
    </p>
  </div>
</section>