---
import CurvedSeparator from "../components/CurvedSeparator.astro";
import SectionTitle from "../components/SectionTitle.astro";
import skills from "../data/skills.json";
---

<CurvedSeparator backgroundColor="bg-secondary" pathColor="text-primary" />

<section
  id="skills"
  class="w-full bg-primary px-6 py-24 text-secondary"
>
  <div class="mx-auto max-w-5xl">
    <SectionTitle title="Stack Tecnológico" color="text-secondary" number="03" numberBackground="bg-primary" />

    <div class="mt-16 flex flex-col gap-16">
      {skills.map((group) => (
        <div>
          <h3 class="text-center font-secondary-heavy text-xl uppercase md:text-2xl">
            {group.category}
          </h3>

          <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {group.skills.map((skill) => (
              <li class="flex items-center gap-4 rounded-2xl border-[3px] border-secondary/30 bg-secondary/10 px-6 py-4">
                <img
                  src={skill.icon}
                  alt=""
                  width="32"
                  height="32"
                  class="h-8 w-8 shrink-0"
                />
                <span class="font-secondary-regular text-lg uppercase leading-snug">
                  {skill.name}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>